# Copy to .env (git-ignored) and fill in what you have. Anything left blank is simply off:
# no Twilio -> texts are logged, no Resend -> emails are logged, no Deepgram -> voicemails aren't transcribed.
# Real environment variables override this file.

# --- Model (at least one) -------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL_SMALL=gpt-4o-mini
OPENAI_MODEL_FAST=gpt-4o-mini
OPENAI_MODEL_CAPABLE=gpt-4o-mini

# Self-hosted, OpenAI-compatible (e.g. Ollama: http://gpu-box:11434/v1)
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=
LOCAL_LLM_API_KEY=
LLM_PRIMARY=openai
LOCAL_LLM_MAX_CONCURRENCY=2

# --- Twilio (texts, calls, recordings) -----------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_DEFAULT_FROM=
# The public URL Twilio calls (e.g. your ngrok URL). Must match for signature checks.
PUBLIC_BASE_URL=
# Set to false while testing without a public URL.
TWILIO_VALIDATE_SIGNATURES=

# --- Email and transcription ---------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=Front Desk <assistant@example.com>
DEEPGRAM_API_KEY=

# --- App -------------------------------------------------------------------------
PORT=5001
ADMIN_TOKEN=change-me
UPLOAD_TOKEN=
# Leave empty to use the embedded database in data/pglite (development only).
DATABASE_URL=
DEFAULT_SLUG=
DASHBOARD_URL=
TERMS_URL=https://inventiq.net/terms.html
PRIVACY_URL=https://inventiq.net/privacy.html
SESSION_IDLE_MINUTES=30
