# Copy to .env (git-ignored) and fill in what you have. Anything left blank is simply off:
# no Twilio -> texts are logged, no Resend -> emails are logged, no Deepgram -> voicemails aren't transcribed.
# Real environment variables override this file.

# --- Model (at least one) -------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL_SMALL=gpt-4o-mini-2024-07-18
OPENAI_MODEL_FAST=gpt-4o-mini-2024-07-18
OPENAI_MODEL_CAPABLE=gpt-4o-mini-2024-07-18

# Self-hosted, OpenAI-compatible (e.g. Ollama: http://gpu-box:11434/v1)
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=
LOCAL_LLM_API_KEY=
LLM_PRIMARY=openai
LOCAL_LLM_MAX_CONCURRENCY=2

# --- Twilio (texts, calls, recordings) -----------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_DEFAULT_FROM=
# The public URL Twilio calls (e.g. your ngrok URL). Must match for signature checks.
PUBLIC_BASE_URL=
# Set to false while testing without a public URL.
TWILIO_VALIDATE_SIGNATURES=

# --- Email and transcription ---------------------------------------------------
RESEND_API_KEY=
# Or email through SMTP. Gmail: GMAIL_USER=you@gmail.com and GMAIL_APP_PASSWORD=<16-character App Password>
# (needs 2-step verification on the account). Any other host: SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASSWORD.
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM=Front Desk <assistant@example.com>
DEEPGRAM_API_KEY=

# --- App -------------------------------------------------------------------------
PORT=5001
ADMIN_TOKEN=change-me
UPLOAD_TOKEN=
# Leave empty to use the embedded database in data/pglite (development only).
DATABASE_URL=
DEFAULT_SLUG=
DASHBOARD_URL=
TERMS_URL=https://inventiq.net/terms.html
PRIVACY_URL=https://inventiq.net/privacy.html
SESSION_IDLE_MINUTES=30

# Optional: require this code on the public /onboarding page (blank = open)
ONBOARDING_CODE=

# --- Voice pipeline ---------------------------------------------------------------------------
# twilio_gather (default): Twilio listens and speaks. Nothing else to run.
# media_streams: Twilio streams audio to us; Deepgram transcribes, Deepgram Aura (en/es) or OpenAI speaks.
#   Needs DEEPGRAM_API_KEY (and PUBLIC_BASE_URL reachable over wss://).
# media_streams_local: Whisper on your own GPU machine transcribes, Deepgram is the backup.
#   Needs LOCAL_STT_BASE_URL; LOCAL_TTS_BASE_URL optional (otherwise Deepgram/OpenAI speak).
VOICE_PIPELINE=twilio_gather
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
# OpenAI-compatible speech servers, e.g. speaches / faster-whisper-server and Kokoro-FastAPI:
LOCAL_STT_BASE_URL=
LOCAL_STT_MODEL=Systran/faster-whisper-large-v3
LOCAL_STT_MAX_CONCURRENCY=8
LOCAL_STT_TIMEOUT_MS=4000
LOCAL_TTS_BASE_URL=
LOCAL_TTS_MODEL=kokoro
LOCAL_TTS_VOICE=af_heart
LOCAL_TTS_LANGUAGES=en,es,fr,pt,zh

# Business-owner logins: signs their sessions (defaults to a value derived from ADMIN_TOKEN)
SESSION_SECRET=
# Where to email when a new client finishes the onboarding page (blank = no email)
ONBOARDING_NOTIFY_EMAIL=
